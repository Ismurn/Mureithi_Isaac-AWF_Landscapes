# R session files
.Rhistory
.Rdata
.RData
.Ruserdata
.Rproj.user/

# renv library (tracked via renv.lock, not the library itself)
renv/library/
renv/staging/
renv/sandbox/

# Byte-compiled files
*.pyc
__pycache__/

# OS files
.DS_Store
Thumbs.db

# Large spatial data (keep raw CSV, ignore large rasters/shapefiles)
*.tif
*.tiff
*.img
*.hdf
*.nc
*.gdb/
*.gpkg
!data/raw/*.gpkg
!data/processed/*.gpkg

# Temporary/intermediate files
*.aux.xml
*.cpg
*.dbf
*.prj
*.sbn
*.sbx
*.shx
*.xml
*.lock
!renv.lock

# IDE
.vscode/
.idea/

# Output images (regenerated by scripts; uncomment to track them)
# outputs/figures/*.png
# outputs/figures/*.pdf

# Knitted reports
*.html
!README.html
